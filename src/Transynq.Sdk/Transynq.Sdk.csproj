<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Transynq.Sdk</RootNamespace>
    <AssemblyName>Transynq.Sdk</AssemblyName>
    <PackageId>Transynq.Sdk</PackageId>
    <Title>Transynq TMS .NET SDK</Title>
    <Version>1.0.2</Version>
    <Description>Official .NET SDK for Transynq TMS, the transport management system for carriers, fleet operators, 3PLs, brokers and shippers: bookings, dispatch, live tracking, driver POD, invoicing and costing through the Transynq API.</Description>
    <PackageTags>transynq;tms;transport-management-system;transport-management-software;transport;logistics;freight;trucking;fleet-management;dispatch;3pl;proof-of-delivery;shipment-tracking;api-client;sdk;dotnet;csharp</PackageTags>
    <PackageReleaseNotes>https://github.com/transynq-io/transynq-sdk-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>transynq-icon-128.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/transynq-io/transynq-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://transynq.io/transport-management-system</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- generated code: 700+ methods; analyzers that only restate style do not apply to it -->
    <NoWarn>$(NoWarn);CA1724;CA1716;CA1720;CA1711;CA1707;CA2227;CA1002;CA1056;CA1054;CA1055;CA1034;CA1819;CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Transynq.Sdk.Tests" />
    <None Include="..\..\PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\brand\transynq-icon-128.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
