<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Transynq.Sdk</RootNamespace>
    <AssemblyName>Transynq.Sdk</AssemblyName>
    <PackageId>Transynq.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Description>Official .NET client for the Transynq TMS API.</Description>
    <PackageTags>transynq;tms;transport;logistics;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/qadir0108/transynq-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/qadir0108/transynq-sdk-dotnet</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- generated code: 700+ methods; analyzers that only restate style do not apply to it -->
    <NoWarn>$(NoWarn);CA1724;CA1716;CA1720;CA1711;CA1707;CA2227;CA1002;CA1056;CA1054;CA1055;CA1034;CA1819;CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Transynq.Sdk.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
