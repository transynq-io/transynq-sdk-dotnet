{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src/Transynq.Sdk",
          "files": ["Transynq.Sdk.csproj"]
        }
      ],
      "properties": { "TargetFramework": "net8.0" },
      "dest": "_api"
    }
  ],
  "build": {
    "content": [
      { "files": ["_api/**.yml", "_api/index.md"] },
      { "files": ["docs/**.md", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "CODE_OF_CONDUCT.md", "toc.yml"] }
    ],
    "resource": [
      { "files": ["LICENSE", "examples/**/*.cs"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Transynq .NET SDK",
      "_appTitle": "Transynq .NET SDK",
      "_enableSearch": true
    }
  }
}
