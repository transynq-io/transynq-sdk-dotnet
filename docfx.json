{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src/Transynq.Sdk",
          "files": [
            "Transynq.Sdk.csproj"
          ]
        }
      ],
      "properties": {
        "TargetFramework": "net8.0"
      },
      "dest": "_api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "_api/**.yml",
          "_api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "README.md",
          "CHANGELOG.md",
          "CONTRIBUTING.md",
          "SECURITY.md",
          "CODE_OF_CONDUCT.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "LICENSE",
          "examples/**/*.cs",
          "assets/brand/*.png",
          "assets/brand/favicon.ico"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/transynq"
    ],
    "globalMetadata": {
      "_appName": "Transynq .NET SDK",
      "_appTitle": "Transynq .NET SDK",
      "_appLogoPath": "assets/brand/transynq-icon-64.png",
      "_appFaviconPath": "assets/brand/favicon.ico",
      "_appFooter": "<span>&copy; 2026 <a href=\"https://transynq.io/\">Transynq</a> &middot; <a href=\"https://transynq.io/transport-management-system\">Transynq TMS - transport management system</a> &middot; MIT licence</span>",
      "_enableSearch": true,
      "_description": "Official .NET SDK for Transynq TMS, the transport management system for carriers, fleet operators, 3PLs, brokers and shippers: bookings, dispatch, live tracking, driver POD, invoicing and costing through the Transynq API."
    }
  }
}
